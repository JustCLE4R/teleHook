# Copy to .env and fill in. Never commit .env: it contains the bot token.

# Port the HTTP server listens on.
PORT=3000

# Required. Bot token from @BotFather, format <bot id>:<secret>.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional settings (defaults shown).
# Maximum chat IDs accepted in one request (1-100).
# MAX_RECIPIENTS_PER_REQUEST=20
# Timeout for each Telegram API call, in milliseconds (1000-60000).
# TELEGRAM_REQUEST_TIMEOUT_MS=10000
# Rate limit: at most RATE_LIMIT_MAX_REQUESTS requests per client IP per RATE_LIMIT_TTL_MS.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX_REQUESTS=10
